---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Main Pages -->
  {% for page in site.pages %}
    {% if page.url contains '.html' and page.name != 'googleab578e53430b81a4.html' and page.name != '404.html' %}
    <url>
      <loc>{{ site.url }}{{ page.url | relative_url }}</loc>
      <changefreq>weekly</changefreq>
      <priority>{% if page.url == '/index.html' or page.url == '/' %}1.0{% else %}0.8{% endif %}</priority>
    </url>
    {% endif %}
  {% endfor %}

  <!-- Blog Collection Posts -->
  {% for post in site.blog %}
    <url>
      <loc>{{ site.url }}{{ post.url | relative_url }}</loc>
      <changefreq>monthly</changefreq>
      <priority>0.7</priority>
    </url>
  {% endfor %}

  <!-- Qronicle Collection Posts -->
  {% for post in site.qronicle %}
    <url>
      <loc>{{ site.url }}{{ post.url | relative_url }}</loc>
      <changefreq>monthly</changefreq>
      <priority>0.7</priority>
    </url>
  {% endfor %}
</urlset>